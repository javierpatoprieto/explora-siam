# Solo hacen falta para activar el panel de edición /keystatic en producción.
# Se obtienen creando la app de GitHub desde /keystatic en local (Keystatic lo guía).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Opcional: ID de Google Analytics 4 (G-XXXXXXX). Si está vacío, no se carga nada.
PUBLIC_GA_ID=
