---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const site = (await getEntry('site', 'site'))!.data;
const home = (await getEntry('home', 'home'))!.data;
---
<Base title={`${p.data.titulo} · ${site.marca}`} noindex={true}>
  <Nav site={site} dark={false} />
  <main class="wrap legal"><h1>{p.data.titulo}</h1><div class="legal__body"><Content /></div></main>
  <Footer site={site} frase={home.footer.frase} />
</Base>
<style is:global>
  .legal { padding-top: 160px; max-width: 820px; }
  .legal h1 { font-size: clamp(36px, 5vw, 64px); margin-bottom: 32px; }
  .legal__body { font-size: 16px; color: var(--ink-2); }
  .legal__body h2, .legal__body h3 { font-family: var(--texto); text-transform: none; letter-spacing: 0; font-weight: 700; font-size: 20px; margin: 32px 0 12px; color: var(--ink); }
  .legal__body p { margin: 0 0 14px; }
  .legal__body ul { padding-left: 20px; }
  .legal__body a { text-decoration: underline; }

</style>
