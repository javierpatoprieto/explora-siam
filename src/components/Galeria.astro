---
import { Image } from 'astro:assets';
import Wa from './Wa.astro';
const { site, g } = Astro.props;
const PLAY = '<span class="play" aria-hidden="true"><svg width="56" height="56" viewBox="0 0 64 64"><circle cx="32" cy="32" r="31" fill="#bf7c6f"></circle><path d="M26 21v22l18-11z" fill="#2a2124"></path></svg></span>';
---
<section class="gal section" id="galeria">
  <div class="wrap gal__head" data-reveal><span class="label vino">{g.etiqueta}</span>{g.intro && <p class="gal__intro">{g.intro}</p>}</div>
  <div class="gal__grid" data-reveal>
    {g.piezas.map((p: any, i: number) => (
      <figure class:list={['gal__item', `gal__item--${p.tamano}`]}>
        <button class="gal__btn" data-full={p.imagen.src} data-pie={p.pie} aria-label={`Ampliar: ${p.pie || 'imagen ' + (i + 1)}`}>
          <Image src={p.imagen} alt={p.pie} class="cover" widths={[500, 800, 1200, 1600]} sizes={p.tamano === 'sangre' ? '100vw' : '(max-width: 760px) 100vw, 40vw'} />
          {p.video && <Fragment set:html={PLAY} />}
        </button>
        {p.pie && <figcaption class="cap">{p.video ? 'Vídeo · ' : ''}{p.pie}</figcaption>}
      </figure>
    ))}
  </div>
  <div class="wrap gal__foot">
    <a href={site.instagram} class="link" target="_blank" rel="noopener">{g.enlaceInstagram} →</a>
    <Wa site={site} origen="galeria" class="btn btn--line" icon={false}>Hablemos por WhatsApp</Wa>
  </div>
  <dialog class="lb" id="lb"><button class="lb__close" id="lbClose" aria-label="Cerrar">×</button><img id="lbImg" alt="" /><p class="lb__pie" id="lbPie"></p></dialog>
</section>
<style>
  .gal__head { display: flex; flex-direction: column; gap: 16px; margin-bottom: 32px; }
  .gal__intro { max-width: 22ch; font-family: var(--display); font-size: clamp(26px, 2.8vw, 40px); line-height: 1.02; color: var(--ink); }
  .vino { color: var(--ink); }
  .gal__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: 150px; gap: 20px; max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); grid-auto-flow: dense; }
  .gal__item { position: relative; margin: 0; overflow: hidden; }
  .gal__item--alto { grid-column: span 5; grid-row: span 5; }
  .gal__item--medio { grid-column: span 4; grid-row: span 3; }
  .gal__item--pequeno { grid-column: span 3; grid-row: span 3; }
  .gal__item--sangre { grid-column: 1 / -1; grid-row: span 4; margin: 0 calc(-1 * var(--gutter)); }
  .gal__item--tercio { grid-column: span 4; grid-row: span 4; }
  .gal__btn { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: var(--bg-3); cursor: zoom-in; }
  .gal__btn :global(img) { transition: transform .6s var(--ease); }
  .gal__btn:hover :global(img) { transform: scale(1.03); }
  .play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .gal__item--sangre .cap { left: var(--gutter); }
  .gal__foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 32px; flex-wrap: wrap; }
  .lb { border: 0; padding: 0; background: transparent; max-width: min(96vw, 1400px); max-height: 96vh; }
  .lb::backdrop { background: rgba(42,33,36,.96); }
  .lb img { max-height: 86vh; width: auto; margin: 0 auto; }
  .lb__pie { color: #fff; text-align: center; margin-top: 12px; font-size: 14px; font-weight: 600; }
  .lb__close { position: fixed; top: 16px; right: 16px; width: 48px; height: 48px; border-radius: 999px; border: 0; background: var(--accent); color: var(--ink); font-size: 28px; cursor: pointer; }
  @media (max-width: 760px) {
    .gal__grid { display: flex; flex-direction: column; gap: 12px; padding: 0; }
    .gal__item { aspect-ratio: 4 / 5; margin: 0 var(--gutter) !important; }
    .gal__item--sangre, .gal__item--alto { margin: 0 !important; }
    .gal__item--sangre { aspect-ratio: 16 / 10; }
    .gal__item--sangre .cap { left: var(--gutter); }
    .gal__foot { margin-top: 24px; }
  }
</style>
<script>
  const lb = document.getElementById('lb') as HTMLDialogElement; const img = document.getElementById('lbImg') as HTMLImageElement; const pie = document.getElementById('lbPie')!;
  document.querySelectorAll<HTMLButtonElement>('.gal__btn').forEach((b) => b.addEventListener('click', () => { img.src = b.dataset.full!; pie.textContent = b.dataset.pie || ''; lb.showModal(); }));
  document.getElementById('lbClose')!.addEventListener('click', () => lb.close());
  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
</script>
