---
const { cifras } = Astro.props;
---
<section class="cifras" aria-label="La ruta en cifras">
  <div class="wrap cifras__in">
    {cifras.map((c: any) => (
      <div class="cifra" data-reveal>
        <span class="cifra__n">{c.valor} <small>{c.unidad}</small></span>
        <span class="cifra__t">{c.etiqueta}</span>
      </div>
    ))}
  </div>
</section>
<style>
  .cifras { border-bottom: 1px solid var(--linea); }
  .cifras__in { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cifra { display: flex; flex-direction: column; gap: 6px; padding: 32px 24px 32px 0; border-left: 1px solid var(--linea); padding-left: 24px; }
  .cifra:first-child { border-left: 0; padding-left: 0; }
  .cifra__n { font-family: var(--display); font-size: clamp(36px, 3.6vw, 56px); line-height: 1; letter-spacing: -0.005em; }
  .cifra__n small { font-size: .45em; font-family: var(--texto); font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--gris); }
  .cifra__t { font-size: 14px; color: var(--gris); }
  @media (max-width: 900px) { .cifras__in { grid-template-columns: repeat(2, minmax(0, 1fr)); } .cifra { padding: 20px 16px 20px 0; } .cifra:nth-child(odd) { border-left: 0; padding-left: 0; } .cifra:nth-child(even) { padding-left: 16px; } }
</style>
