---
import { Image } from 'astro:assets';
import Wa from './Wa.astro';
const { site, dia } = Astro.props;
const primera = dia.paradas[0]?.hora; const ultima = dia.paradas.at(-1)?.hora;
---
<section class="dia oscuro section" id="como-viajamos">
  <div class="wrap dia__head" data-reveal>
    <div><span class="label ambar">{dia.etiqueta}</span><h2>{dia.titulo}</h2></div>
    <div class="dia__progress label" aria-hidden="true"><span>{primera}</span><div class="bar"><div class="bar__fill" id="diaBar"></div></div><span>{ultima}</span></div>
  </div>
  <div class="dia__track" id="diaTrack" data-reveal>
    {dia.paradas.map((p: any) => (
      <figure class="stop">
        <Image src={p.imagen} alt="" class="cover" widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 640px" />
        <div class="stop__shade"></div>
        <figcaption class="stop__text">
          <span class="label ambar">{p.hora}</span>
          <strong class="stop__title">{p.titulo}</strong>
          <span class="stop__desc">{p.texto}</span>
        </figcaption>
      </figure>
    ))}
    <div class="stop stop--end">
      <p class="stop__title">{dia.cierre}</p>
      <Wa site={site} origen="dia">{dia.cierreBoton}</Wa>
    </div>
  </div>
</section>
<style>
  .dia { padding-bottom: clamp(80px, 10vw, 136px); overflow: hidden; }
  .dia__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: 48px; }
  .dia__head .label { display: block; margin-bottom: 14px; }
  .ambar { color: var(--ambar); }
  .dia__progress { display: flex; align-items: center; gap: 16px; color: rgba(251,243,230,.6); }
  .bar { width: 200px; height: 2px; background: rgba(251,243,230,.2); position: relative; }
  .bar__fill { position: absolute; left: 0; top: 0; height: 2px; width: 10%; background: var(--coral); transition: width .2s; }
  .dia__track { display: flex; gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 var(--gutter) 12px; scrollbar-width: none; }
  .dia__track::-webkit-scrollbar { display: none; }
  .stop { position: relative; flex: 0 0 640px; height: 440px; margin: 0; overflow: hidden; scroll-snap-align: start; background: var(--tinta-2); }
  .stop__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(42,14,20,0) 30%, rgba(42,14,20,.88) 100%); }
  .stop__text { position: absolute; left: 24px; right: 24px; bottom: 24px; display: flex; flex-direction: column; gap: 6px; }
  .stop__title { font-family: var(--display); text-transform: uppercase; font-size: 44px; line-height: .98; font-weight: 400; text-shadow: 0 2px 24px rgba(42,14,20,.6); }
  .stop__desc { font-size: 16px; opacity: .95; }
  .stop--end { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 24px; padding: 32px; background: var(--vino); flex-basis: 480px; }
  .stop--end .stop__title { font-size: 40px; }
  @media (max-width: 760px) {
    .dia__head { flex-direction: column; align-items: flex-start; margin-bottom: 28px; }
    .dia__progress { display: none; }
    .dia__track { flex-direction: column; overflow: visible; gap: 28px; scroll-snap-type: none; }
    .stop { flex: none; height: auto; display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 12px; background: none; overflow: visible; }
    .stop :global(img) { position: relative; grid-column: 2; aspect-ratio: 4 / 5; height: auto; }
    .stop__shade { display: none; }
    .stop__text { position: static; grid-column: 2; gap: 8px; }
    .stop__text .label { grid-column: 1; grid-row: 1; position: absolute; left: 0; top: 4px; }
    .stop__title { font-size: 30px; text-shadow: none; }
    .stop__desc { color: rgba(251,243,230,.85); }
    .stop--end { display: flex; grid-template-columns: none; padding: 28px 24px; }
    .stop--end :global(.btn) { width: 100%; }
  }
</style>
<script>
  const t = document.getElementById('diaTrack'); const f = document.getElementById('diaBar');
  if (t && f) t.addEventListener('scroll', () => { const max = t.scrollWidth - t.clientWidth; f.style.width = (10 + 90 * (max ? t.scrollLeft / max : 0)) + '%'; }, { passive: true });
</script>
