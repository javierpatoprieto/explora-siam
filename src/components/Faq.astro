---
import Wa from './Wa.astro';
const { site, faq, items, todas = false } = Astro.props;
---
<section class="faq section wrap" id="preguntas">
  <div class="faq__intro" data-reveal>
    <h2 class="faq__h">{faq.titulo}</h2>
    <p class="faq__p">{faq.intro}</p>
    <Wa site={site} origen="faq" class="link" icon={false}>{faq.enlace} →</Wa>
    {!todas && <a href="/preguntas" class="faq__all">{faq.verTodas} →</a>}
  </div>
  <div class="chat" data-reveal>
    {items.map((f: any) => (
      <div class="hilo">
        <p class="q">{f.data.pregunta}</p>
        <div class="a"><p>{f.data.respuesta}</p><img src="/logo.png" alt="" width="36" height="36" /></div>
      </div>
    ))}
  </div>
</section>
<style>
  .faq { display: grid; grid-template-columns: 4fr 8fr; gap: 64px; align-items: start; }
  .faq__intro { position: sticky; top: 100px; display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .faq__h { font-size: clamp(40px, 4.4vw, 64px); }
  .faq__p { color: var(--texto-2); font-size: 18px; }
  .faq__all { font-weight: 700; }
  .chat { display: flex; flex-direction: column; gap: 28px; }
  .hilo { display: flex; flex-direction: column; gap: 10px; }
  .q { align-self: flex-start; max-width: 78%; background: var(--crema-2); padding: 16px 20px; border-radius: 18px 18px 18px 4px; font-size: 18px; line-height: 1.45; }
  .a { align-self: flex-end; display: flex; gap: 12px; align-items: flex-end; max-width: 82%; }
  .a p { background: var(--tinta); color: var(--crema); padding: 16px 20px; border-radius: 18px 18px 4px 18px; font-size: 18px; line-height: 1.45; }
  .a img { flex: 0 0 auto; }
  @media (max-width: 900px) { .faq { grid-template-columns: 1fr; gap: 28px; } .faq__intro { position: static; } .q, .a { max-width: 92%; } .q, .a p { font-size: 16px; padding: 12px 16px; } .a img { width: 30px; height: 30px; } }
</style>
