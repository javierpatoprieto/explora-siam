---
import Wa from './Wa.astro';
const { site, faq, items, todas = false } = Astro.props;
---
<section class="faq wrap section" id="preguntas">
  <div class="faq__head center" data-reveal><h2>{faq.titulo}</h2><p class="sub">{faq.intro}</p></div>
  <div class="faq__list" data-reveal>
    {items.map((f: any, i: number) => (
      <details class="q" open={i === 0}>
        <summary><span>{f.data.pregunta}</span><i aria-hidden="true"></i></summary>
        <p>{f.data.respuesta}</p>
      </details>
    ))}
  </div>
  <div class="faq__foot center">
    {!todas && <a href="/preguntas" class="btn btn--ghost">{faq.verTodas}</a>}
    <Wa site={site} origen="faq" icon={false}>{faq.enlace}</Wa>
  </div>
</section>
<style>
  .faq__head { display: flex; flex-direction: column; align-items: center; gap: 12px; margin-bottom: 32px; }
  .faq__list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
  .q { background: var(--bg-2); border-radius: 16px; padding: 0 20px; }
  .q[open] { background: #fff; box-shadow: 0 0 0 1px var(--line); }
  .q summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; cursor: pointer; font-weight: 500; font-size: 16px; letter-spacing: -0.01em; }
  .q summary::-webkit-details-marker { display: none; }
  .q summary i { flex: 0 0 auto; width: 26px; height: 26px; border-radius: 999px; background: var(--ink); position: relative; transition: transform .3s var(--ease); }
  .q summary i::before, .q summary i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; background: #fff; transform: translate(-50%, -50%); }
  .q summary i::after { transform: translate(-50%, -50%) rotate(90deg); }
  .q[open] summary i { transform: rotate(45deg); }
  .q p { padding: 0 0 18px; color: var(--ink-2); font-size: 15px; max-width: 62ch; }
  .faq__foot { display: flex; justify-content: center; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
</style>
