---
import Wa from './Wa.astro';
const { site, proxima, soloBarra = false } = Astro.props;
---
<div class="flot" id="flot" hidden={true} data-solo-barra={soloBarra ? '1' : undefined}><Wa site={site} origen="flotante" class="flot__btn" label="Hablemos por WhatsApp"><span class="flot__txt">¿Hablamos?</span></Wa></div>
<div class="bar" id="mbar" hidden>
  {proxima && <p class="bar__ctx label">{proxima.nombre} · {proxima.fechas}{proxima.disponibles > 0 && proxima.disponibles < proxima.plazas && <span class="vino"> · quedan {proxima.disponibles}</span>}</p>}
  <Wa site={site} origen="flotante">Hablemos por WhatsApp</Wa>
</div>
<style>
  .flot[hidden] { display: none; }
  .flot { position: fixed; right: 32px; bottom: 32px; z-index: 40; }
    .bar { display: none; }
  @media (max-width: 760px) {
    .flot { display: none; }
    .bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; flex-direction: column; gap: 8px; padding: 10px 16px calc(14px + env(safe-area-inset-bottom)); background: rgba(243,238,230,.94); backdrop-filter: blur(12px); border-top: 1px solid var(--linea); transform: translateY(100%); transition: transform .35s var(--ease); }
    .bar.show { transform: none; }
    .bar[hidden] { display: flex; }
    .bar__ctx { text-align: center; color: var(--gris); font-size: 12px; }
    .vino { color: var(--vino); font-weight: 700; }
    .bar :global(.btn) { width: 100%; }
  }
</style>
<script>
  const hero = document.getElementById('hero'); const cta = document.getElementById('contacto');
  const flot = document.getElementById('flot')!; const bar = document.getElementById('mbar')!;
  let heroVisible = true, ctaVisible = false;
  const apply = () => { const show = !heroVisible && !ctaVisible; flot.hidden = !show || flot.dataset.soloBarra === '1'; bar.hidden = false; bar.classList.toggle('show', show); };
  const io = new IntersectionObserver((es) => { es.forEach((e) => { if (e.target === hero) heroVisible = e.isIntersecting; if (e.target === cta) ctaVisible = e.isIntersecting; }); apply(); }, { threshold: 0.15 });
  if (hero) io.observe(hero); else heroVisible = false;
  if (cta) io.observe(cta);
  apply();
  setTimeout(() => { flot.classList.add('open'); setTimeout(() => flot.classList.remove('open'), 4000); }, 3000);
</script>
