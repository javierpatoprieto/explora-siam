---
import { Image } from 'astro:assets';
const { v } = Astro.props;
---
<section class="band" id="video">
  <Image src={v.poster} alt="" class="cover" widths={[800, 1200, 1600, 2000]} sizes="100vw" />
  <div class="band__shade"></div>
  {v.mp4 ? (
    <button class="band__play" id="bandPlay" aria-label="Reproducir vídeo"><svg width="72" height="72" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="31" fill="#d97f70"></circle><path d="M26 21v22l18-11z" fill="#2b171b"></path></svg></button>
  ) : (
    <div class="band__play" aria-hidden="true"><svg width="72" height="72" viewBox="0 0 64 64"><circle cx="32" cy="32" r="31" fill="#d97f70"></circle><path d="M26 21v22l18-11z" fill="#2b171b"></path></svg></div>
  )}
  {v.mp4 && <video class="cover band__video" id="bandVideo" src={v.mp4} preload="none" playsinline controls hidden></video>}
  <div class="wrap band__text">
    <span class="label ambar">{v.etiqueta}</span>
    <p class="band__title">{v.titulo}</p>
  </div>
</section>
<style>
  .band { position: relative; min-height: clamp(420px, 50vw, 720px); background: var(--tinta); color: var(--crema); display: flex; align-items: flex-end; overflow: hidden; }
  .band__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(43,23,27,.15), rgba(43,23,27,.6)); }
  .band__play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: none; border: 0; cursor: pointer; }
  .band__play svg { transition: transform .3s var(--ease); }
  .band__play:hover svg { transform: scale(1.06); }
  .band__video { z-index: 3; }
  .band__text { position: relative; display: flex; flex-direction: column; gap: 10px; padding-bottom: 40px; pointer-events: none; }
  .ambar { color: var(--ambar); }
  .band__title { font-family: var(--display); text-transform: uppercase; font-size: clamp(30px, 3.6vw, 52px); line-height: .98; max-width: 16ch; }
</style>
<script>
  const b = document.getElementById('bandPlay'); const v = document.getElementById('bandVideo') as HTMLVideoElement | null;
  if (b && v) b.addEventListener('click', () => { v.hidden = false; b.hidden = true; v.play(); });
</script>
