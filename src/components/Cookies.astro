---
// Aviso de cookies con consentimiento previo (RGPD/LSSI) y Consent Mode v2.
//
// Tres reglas que cumple este componente:
//  1. Nada de Google se descarga hasta que la persona acepta.
//  2. Aceptar y rechazar cuestan lo mismo: un clic y el mismo botón.
//  3. La decisión se puede cambiar siempre, desde el pie de página.
const { ga } = Astro.props;
---
{ga && (
  <>
    <div class="ck" id="ck" hidden role="dialog" aria-live="polite" aria-label="Aviso de cookies">
      <p>Usamos cookies de Google Analytics para saber qué partes de la web interesan más. Solo se activan si las aceptas. Puedes leer más en la <a href="/cookies">política de cookies</a>.</p>
      <div class="ck__btns">
        <button class="btn btn--ghost btn--sm" id="ckNo" type="button">Rechazar</button>
        <button class="btn btn--ghost btn--sm" id="ckSi" type="button">Aceptar</button>
      </div>
    </div>
    <style>
      .ck { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 60; max-width: 460px; margin-left: auto; background: #fff; border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow); padding: 18px 20px; display: flex; flex-direction: column; gap: 14px; font-size: 14px; color: var(--ink-2); }
      .ck[hidden] { display: none; }
      .ck a { text-decoration: underline; text-underline-offset: 3px; }
      /* Los dos botones pesan igual: la AEPD exige que rechazar sea tan sencillo y tan visible como aceptar. */
      .ck__btns { display: flex; gap: 8px; justify-content: flex-end; }
      .ck__btns .btn { flex: 0 0 auto; min-width: 110px; justify-content: center; }
      @media (max-width: 760px) { .ck { bottom: 84px; } .ck__btns .btn { flex: 1 1 0; } }
    </style>
    <script is:inline define:vars={{ ga }}>
      (function () {
        var CLAVE = 'es-cookies';
        var caja = document.getElementById('ck');

        // Consent Mode v2. Se declara ANTES de cargar nada de Google y con todo
        // denegado por defecto. Sin esto, Google no considera válido el tráfico
        // del Espacio Económico Europeo.
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500
        });

        function cargar() {
          if (window.__ga) return;
          window.__ga = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga;
          document.head.appendChild(s);
          window.gtag('js', new Date());
          window.gtag('config', ga, { anonymize_ip: true });
        }

        // No hacemos publicidad: los permisos de anuncios siguen denegados
        // incluso al aceptar. Solo se concede la medición.
        function aplicar(v) {
          window.gtag('consent', 'update', { analytics_storage: v === 'si' ? 'granted' : 'denied' });
          if (v === 'si') cargar();
        }

        function guardar(v) {
          try { localStorage.setItem(CLAVE, JSON.stringify({ v: v, f: Date.now() })); } catch (e) {}
          caja.hidden = true;
          aplicar(v);
        }

        var previo = null;
        try { previo = JSON.parse(localStorage.getItem(CLAVE) || 'null'); } catch (e) {}
        var vigente = previo && Date.now() - previo.f < 365 * 24 * 3600 * 1000;
        if (vigente) aplicar(previo.v);
        else caja.hidden = false;

        document.getElementById('ckSi').addEventListener('click', function () { guardar('si'); });
        document.getElementById('ckNo').addEventListener('click', function () { guardar('no'); });

        // Retirar el consentimiento tiene que ser tan fácil como darlo: cualquier
        // elemento con data-ck (el enlace del pie) vuelve a abrir el aviso.
        document.addEventListener('click', function (e) {
          var t = e.target.closest ? e.target.closest('[data-ck]') : null;
          if (!t) return;
          e.preventDefault();
          try { localStorage.removeItem(CLAVE); } catch (err) {}
          caja.hidden = false;
          caja.scrollIntoView({ block: 'nearest' });
        });
      })();
    </script>
  </>
)}
