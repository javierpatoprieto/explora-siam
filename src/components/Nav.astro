---
import Wa from './Wa.astro';
const { site } = Astro.props;
---
<header class="nav" id="nav">
  <div class="wrap nav__in">
    <a href="/" class="nav__brand" aria-label={site.marca}>
      <img src="/logo.png" alt="" width="52" height="52" />
      <span>{site.marca}</span>
    </a>
    <nav class="nav__links" aria-label="Secciones">
      <a href="/#salidas">La ruta</a>
      <a href="/#precio">Precio</a>
      <a href="/preguntas">Preguntas</a>
    </nav>
    <div class="nav__cta"><Wa site={site} origen="nav" class="btn btn--sm">Hablemos por WhatsApp</Wa></div>
    <button class="nav__burger" id="burger" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú"><span></span><span></span></button>
  </div>
  <div class="menu" id="menu" hidden>
    <a href="/#salidas">La ruta</a>
    <a href="/#precio">Precio</a>
    <a href="/preguntas">Preguntas</a>
    <Wa site={site} origen="nav">Hablemos por WhatsApp</Wa>
  </div>
</header>
<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; transition: background 0.25s, border-color 0.25s; border-bottom: 1px solid transparent; color: var(--crema); }
  .nav.solid { background: rgba(251, 243, 230, 0.9); backdrop-filter: blur(12px); border-color: var(--linea); color: var(--tinta); }
  .nav__in { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 80px; }
  .nav__brand { display: flex; align-items: center; gap: 12px; color: inherit; font-weight: 700; font-size: 18px; letter-spacing: 0.01em; }
  .nav__brand img { width: 48px; height: 48px; }
  .nav__links { display: flex; gap: 36px; font-size: 15px; font-weight: 500; }
  .nav__links a { color: inherit; }
  
  .nav__burger { display: none; width: 44px; height: 44px; background: none; border: 0; flex-direction: column; gap: 7px; align-items: center; justify-content: center; cursor: pointer; }
  .nav__burger span { width: 24px; height: 2px; background: currentColor; transition: transform 0.3s var(--ease); }
  .nav__burger[aria-expanded="true"] span:first-child { transform: translateY(4.5px) rotate(45deg); }
  .nav__burger[aria-expanded="true"] span:last-child { transform: translateY(-4.5px) rotate(-45deg); }
  .menu[hidden] { display: none; }
  .menu { display: flex; flex-direction: column; gap: 20px; padding: 24px var(--gutter) 40px; background: var(--crema); color: var(--tinta); font-family: var(--display); font-size: 36px; text-transform: uppercase; border-bottom: 1px solid var(--linea); }
  .menu a { color: var(--tinta); }
  .menu :global(.btn) { font-family: var(--texto); font-size: 16px; text-transform: none; }
  @media (max-width: 900px) {
    .nav__in { height: 64px; }
    .nav__brand img { width: 40px; height: 40px; }
    .nav__brand span { font-size: 16px; }
    .nav__links, .nav__cta { display: none; }
    .nav__burger { display: flex; }
  }
</style>
<script>
  const nav = document.getElementById('nav')!;
  const burger = document.getElementById('burger')!;
  const menu = document.getElementById('menu')!;
  const update = () => nav.classList.toggle('solid', window.scrollY > 80 || !menu.hidden);
  window.addEventListener('scroll', update, { passive: true });
  burger.addEventListener('click', () => {
    const open = menu.hidden;
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    update();
  });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { menu.hidden = true; burger.setAttribute('aria-expanded', 'false'); update(); }));
  update();
</script>
