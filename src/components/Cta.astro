---
import { Image } from 'astro:assets';
import Wa from './Wa.astro';
const { site, cta } = Astro.props;
---
<section class="cta wrap section" id="contacto">
  <div class="cta__panel" data-reveal>
    <Image src={cta.imagen} alt="" class="cover" widths={[800, 1200, 1600]} sizes="100vw" />
    <div class="cta__shade"></div>
    <div class="cta__in">
      <h2>{cta.titulo}</h2>
      <p>{cta.subtitulo}</p>
      <div class="cta__row"><Wa site={site} origen="final" class="btn btn--light btn--lg">{cta.boton}</Wa>{site.formulario && <a href={site.formulario} class="cta__form" target="_blank" rel="noopener">o rellena el formulario de inscripción</a>}</div>
      <span class="cta__micro">{cta.microcopy} · <a href={`mailto:${site.email}`}>{site.email}</a></span>
    </div>
  </div>
</section>
<style>
  .cta__panel { position: relative; min-height: 520px; border-radius: var(--r-lg); overflow: hidden; display: flex; align-items: center; justify-content: center; text-align: center; color: #fff; }
  .cta__shade { position: absolute; inset: 0; background: rgba(23,24,26,.55); }
  .cta__in { position: relative; display: flex; flex-direction: column; align-items: center; gap: 18px; padding: 48px 24px; max-width: 640px; }
  .cta__in h2 { font-weight: 400; font-size: clamp(32px, 4.4vw, 56px); }
  .cta__in p { color: rgba(255,255,255,.85); }
  .cta__row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }
  .cta__form { color: #fff; font-size: 14px; text-decoration: underline; text-underline-offset: 4px; }
  .cta__micro { font-size: 13px; color: rgba(255,255,255,.7); }
  .cta__micro a { color: inherit; text-decoration: underline; }
</style>
