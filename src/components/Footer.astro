---
const { site, frase } = Astro.props;
---
<footer class="foot wrap">
  <div class="foot__top">
    <div class="foot__brand"><img src="/logo.png" alt="" width="44" height="44" /><div><strong>{site.marca}</strong><span>{frase}</span></div></div>
    <nav class="foot__links" aria-label="Contacto"><a href={site.instagram} target="_blank" rel="noopener">Instagram</a><a href={`mailto:${site.email}`}>{site.email}</a><a href={`tel:+${site.whatsapp}`}>+{site.whatsapp}</a></nav>
  </div>
  <div class="foot__bottom">
    <nav class="foot__legal" aria-label="Legal"><a href="/aviso-legal">Aviso legal</a><a href="/privacidad">Privacidad</a><a href="/cookies">Cookies</a><a href="/condiciones">Condiciones</a><a href="#" data-ck>Configurar cookies</a></nav>
    <span class="foot__meta">{site.ubicacion}{site.licencia && ` · ${site.licencia}`}{site.autor && <> · <a class="foot__autor" href={site.autor.url} target="_blank" rel="noopener">{site.autor.texto}</a></>}</span>
  </div>
</footer>
<style>
  .foot { padding-top: 64px; padding-bottom: 110px; display: flex; flex-direction: column; gap: 28px; font-size: 14px; color: var(--muted); }
  .foot__top { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .foot__brand { display: flex; align-items: center; gap: 12px; color: var(--ink); }
  .foot__brand div { display: flex; flex-direction: column; }
  .foot__brand strong { font-weight: 600; }
  .foot__brand span { color: var(--muted); font-size: 13px; }
  .foot__links, .foot__legal { display: flex; gap: 22px; flex-wrap: wrap; }
  .foot__links a, .foot__legal a { color: var(--ink); }
  .foot__meta { display: inline; }
  .foot__autor { color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--line); transition: color .2s, border-color .2s; }
  .foot__autor:hover { color: var(--ink); border-color: var(--ink); }
  .foot__bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 13px; }
  @media (min-width: 761px) { .foot { padding-bottom: 48px; } }
</style>
