---
import { Image } from 'astro:assets';
import Wa from './Wa.astro';
const { site, hero, proxima } = Astro.props;
const hasVideo = Boolean(hero.videoMp4);
---
<section class="hero" id="hero">
  {hasVideo ? (
    <video class="cover hero__media" autoplay muted loop playsinline preload="metadata" poster={hero.poster.src}>
      {hero.videoWebm && <source src={hero.videoWebm} type="video/webm" />}
      <source src={hero.videoMp4} type="video/mp4" />
    </video>
  ) : (
    <picture>
      <source media="(max-width: 760px)" srcset={hero.posterMovil.src} />
      <Image src={hero.poster} alt="" class="cover hero__media" widths={[800, 1200, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    </picture>
  )}
  <div class="hero__shade"></div>
  <div class="wrap hero__in">
    <span class="hero__badge">{hero.badge}</span>
    <h1>{hero.titulo} <em>{hero.destacado}</em></h1>
    <p class="hero__sub">{hero.subtitulo}</p>
    <div class="hero__cta">
      <Wa site={site} origen="hero">{hero.botonPrimario}</Wa>
      {hero.botonSecundario && <a href="#salidas" class="btn btn--ghost">{hero.botonSecundario}</a>}
    </div>
    {hero.microcopy && <p class="hero__micro label">{hero.microcopy}</p>}
  </div>
  <div class="wrap hero__foot">
    {hero.mostrarProximaSalida && proxima && (
      <a href={`/viajes/${proxima.slug}`} class="hero__next">
        <span class="hero__next-k">Próxima salida</span>
        <span class="hero__next-v">{proxima.fechas}</span>
        <span class="hero__next-m">{proxima.duracion} · {proxima.disponibles < proxima.plazas ? `quedan ${proxima.disponibles} plazas` : `${proxima.plazas} plazas`}</span>
      </a>
    )}
    <span class="hero__scroll label" aria-hidden="true"><span class="hero__line"></span>desliza</span>
  </div>
</section>
<style>
  .hero { position: relative; min-height: min(100svh, 1080px); display: flex; flex-direction: column; justify-content: flex-end; background: var(--tinta); color: var(--crema); overflow: hidden; }
  .hero__media { z-index: 0; object-position: 50% 45%; animation: kb 24s ease-out both; transform-origin: 60% 40%; }
  @keyframes kb { from { transform: scale(1.12); } to { transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) { .hero__media { animation: none; } }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(42,33,36,.35) 0%, rgba(42,33,36,.05) 30%, rgba(42,33,36,.85) 100%); }
  .hero__in { position: relative; width: 100%; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; padding-top: 140px; padding-bottom: 32px; }
  .hero__in h1 { max-width: 14ch; font-size: clamp(48px, 7.4vw, 104px); }
  .hero__in h1 em { font-style: normal; color: var(--coral); }
  .hero__badge { display: inline-block; background: var(--coral); color: var(--tinta); font-size: 13px; font-weight: 700; padding: 8px 14px; border-radius: 999px; }
  .hero__sub { max-width: 520px; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.55; color: rgba(243,238,230,.92); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero__micro { color: rgba(243,238,230,.85); margin-top: -8px; }
  .hero__foot { position: relative; width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-bottom: 28px; padding-top: 24px; color: rgba(243,238,230,.85); flex-wrap: wrap; }
  .hero__scroll { display: inline-flex; align-items: center; gap: 12px; color: rgba(243,238,230,.7); }
  .hero__line { display: block; width: 48px; height: 1px; background: currentColor; animation: grow 2s var(--ease) infinite; transform-origin: left; }
  @keyframes grow { 0% { transform: scaleX(0); } 60% { transform: scaleX(1); } 100% { transform: scaleX(1); opacity: 0; } }

  .hero__next { display: flex; flex-direction: column; gap: 4px; color: var(--crema); padding: 16px 20px; border: 1px solid rgba(243,238,230,.28); border-radius: 4px; backdrop-filter: blur(8px); background: rgba(42,33,36,.25); transition: border-color .25s; }
  .hero__next:hover { border-color: var(--crema); color: var(--crema); }
  .hero__next-k { font-size: 12px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: rgba(243,238,230,.7); }
  .hero__next-v { font-family: var(--display); text-transform: uppercase; font-size: 24px; line-height: 1; }
  .hero__next-m { font-size: 13px; color: rgba(243,238,230,.8); }
  .dot { width: 4px; height: 4px; border-radius: 999px; background: currentColor; opacity: .6; }
  .ambar { color: var(--ambar); }
  @media (max-width: 760px) {
    .hero__in { padding-top: 110px; gap: 18px; }
    .hero__cta { flex-direction: column; width: 100%; }
    .hero__cta :global(.btn) { width: 100%; }
    .hero__foot { padding-bottom: 24px; }
    .hero__scroll { display: none; }
  }
</style>
