---
import { Image } from 'astro:assets';
import Wa from './Wa.astro';
import { precio } from '../lib/wa';
const { site, hero, proxima } = Astro.props;
const hasVideo = Boolean(hero.videoMp4);
---
<section class="hero" id="hero">
  <div class="hero__media">
    {hasVideo ? (
      <video class="cover" autoplay muted loop playsinline preload="metadata" poster={hero.poster.src}>{hero.videoWebm && <source src={hero.videoWebm} type="video/webm" />}<source src={hero.videoMp4} type="video/mp4" /></video>
    ) : (
      <picture><source media="(max-width: 760px)" srcset={hero.posterMovil.src} /><Image src={hero.poster} alt="" class="cover" widths={[800, 1200, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" /></picture>
    )}
    <div class="hero__shade"></div>
  </div>
  <div class="wrap hero__in">
    <div class="hero__copy">
      <span class="hero__badge">{hero.badge}</span>
      <h1>{hero.titulo} <span>{hero.destacado}</span></h1>
      <p class="hero__sub">{hero.subtitulo}</p>
      <div class="hero__cta"><Wa site={site} origen="hero" class="btn btn--light btn--lg">{hero.botonPrimario}</Wa>{hero.microcopy && <span class="hero__micro">{hero.microcopy}</span>}</div>
    </div>
    {proxima && (
      <aside class="widget" aria-label="Próxima salida">
        <div class="widget__tabs"><span class="on">Próxima salida</span><span>Una al año</span></div>
        <dl class="widget__grid">
          <div><dt>Ruta</dt><dd>{proxima.nombre.split(':')[0]}</dd></div>
          <div><dt>Fechas</dt><dd>{proxima.fechas}</dd></div>
          <div><dt>Duración</dt><dd>{proxima.duracion}</dd></div>
          <div><dt>Grupo</dt><dd>6 a {proxima.plazas} personas</dd></div>
          <div class="wide"><dt>Precio</dt><dd>desde {precio(proxima.precio)} <small>· {proxima.notaPrecio}</small></dd></div>
        </dl>
        <Wa site={site} origen="salida" vars={{ nombre: proxima.nombre, fechas: proxima.fechas }} salida={proxima.slug} class="btn widget__btn" icon={false}>Quiero este viaje</Wa>
        <div class="widget__links"><a href={`/viajes/${proxima.slug}`}>Ver el itinerario</a>{site.dossier && <><span>·</span><a href={site.dossier} target="_blank" rel="noopener">Descargar dossier</a></>}</div>
      </aside>
    )}
  </div>
</section>
<style>
  .hero { position: relative; min-height: min(100svh, 900px); display: flex; align-items: center; color: #fff; padding: 120px 0 56px; }
  .hero__media { position: absolute; inset: 0; overflow: hidden; border-radius: 0 0 var(--r-lg) var(--r-lg); background: var(--ink); }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(23,24,26,.55) 0%, rgba(23,24,26,.15) 60%), linear-gradient(0deg, rgba(23,24,26,.45), rgba(23,24,26,0) 50%); }
  .hero__in { position: relative; width: 100%; display: grid; grid-template-columns: 1.15fr .85fr; gap: 48px; align-items: center; }
  .hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .hero__badge { display: inline-block; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.3); backdrop-filter: blur(8px); font-size: 13px; font-weight: 500; }
  .hero h1 { max-width: 13ch; font-weight: 400; }
  .hero h1 span { color: rgba(255,255,255,.72); }
  .hero__sub { max-width: 46ch; font-size: 17px; color: rgba(255,255,255,.88); }
  .hero__cta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .hero__micro { font-size: 13px; color: rgba(255,255,255,.75); }
  .widget { justify-self: end; width: min(100%, 400px); background: #fff; color: var(--ink); border-radius: var(--r-lg); padding: 22px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 16px; }
  .widget__tabs { display: flex; gap: 6px; background: var(--bg-2); border-radius: 999px; padding: 4px; font-size: 13px; font-weight: 500; color: var(--muted); }
  .widget__tabs span { flex: 1; text-align: center; padding: 8px 10px; border-radius: 999px; }
  .widget__tabs .on { background: #fff; color: var(--ink); box-shadow: 0 1px 4px rgba(0,0,0,.08); }
  .widget__grid { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .widget__grid div { border: 1px solid var(--line); border-radius: 14px; padding: 10px 14px; }
  .widget__grid .wide { grid-column: 1 / -1; }
  .widget__grid dt { font-size: 12px; color: var(--muted); }
  .widget__grid dd { margin: 2px 0 0; font-size: 15px; font-weight: 500; letter-spacing: -0.01em; }
  .widget__grid dd small { font-weight: 400; color: var(--muted); font-size: 12px; }
  .widget :global(.widget__btn) { width: 100%; }
  .widget__links { display: flex; justify-content: center; gap: 8px; font-size: 13px; color: var(--muted); }
  .widget__links a { color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  .widget__links a:hover { color: var(--ink); }
  @media (max-width: 900px) {
    .hero { padding: 100px 0 32px; min-height: 0; }
    .hero__in { grid-template-columns: 1fr; gap: 28px; }
    .hero__media { border-radius: 0 0 20px 20px; }
    .widget { justify-self: stretch; width: 100%; }
    .hero__cta :global(.btn) { width: 100%; }
  }
</style>
