---
import { Image } from 'astro:assets';
const { st } = Astro.props;
---
<section class="st wrap section center" data-reveal>
  <h2 class="st__h">{st.antes} <span class="pill"><Image src={st.imagen1} alt="" class="cover" widths={[300, 500]} sizes="140px" /></span> {st.medio} <span class="pill"><Image src={st.imagen2} alt="" class="cover" widths={[300, 500]} sizes="140px" /></span> {st.despues}</h2>
  <p class="sub">{st.texto}</p>
</section>
<style>
  .st { display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .st__h { max-width: 22ch; font-size: clamp(30px, 4.2vw, 56px); line-height: 1.18; font-weight: 400; }
  .pill { position: relative; display: inline-block; vertical-align: middle; width: 2.6em; height: 1.05em; border-radius: 999px; overflow: hidden; margin: 0 .06em; transform: translateY(-.06em); }
</style>
