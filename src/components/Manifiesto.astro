---
import { Image } from 'astro:assets';
const { m } = Astro.props;
---
<section class="mani" id="manifiesto">
  <div class="mani__img">
    <Image src={m.imagen} alt="" class="cover" widths={[800, 1200, 1600, 2200]} sizes="100vw" />
    {m.pie && <span class="cap">{m.pie}</span>}
  </div>
  <div class="wrap mani__grid">
    <h2 class="mani__h" data-reveal>{m.titulo} <em>{m.destacado}</em> {m.cierre}</h2>
    <div class="mani__blocks">
      {m.bloques.map((b: any, i: number) => (<div class="mani__b" data-reveal><span class="mani__i">{String(i + 1).padStart(2, '0')}</span><h3 class="mani__t">{b.titulo}</h3><p>{b.texto}</p></div>))}
    </div>
  </div>
</section>
<style>
  .mani { position: relative; padding-bottom: clamp(72px, 8vw, 120px); }
  .mani__img { position: relative; height: clamp(420px, 72vh, 820px); overflow: hidden; }
  .mani__img .cap { left: auto; right: 16px; }
  .mani__grid { display: grid; grid-template-columns: 7fr 5fr; gap: 64px; align-items: start; }
  .mani__h { margin-top: -0.9em; position: relative; background: var(--crema); padding: 24px 32px 0 0; font-size: clamp(44px, 6vw, 96px); line-height: .92; max-width: 11ch; text-wrap: balance; }
  .mani__h em { font-style: normal; color: var(--coral); }
  .mani__blocks { display: flex; flex-direction: column; gap: 32px; padding-top: 56px; }
  .mani__b { display: grid; grid-template-columns: 40px 1fr; gap: 0 16px; }
  .mani__i { font-family: var(--display); font-size: 22px; color: var(--coral); line-height: 1.3; }
  .mani__t { font-family: var(--texto); text-transform: none; letter-spacing: 0; font-size: 20px; font-weight: 700; margin-bottom: 8px; }
  .mani__b p { grid-column: 2; color: var(--texto-2); }
  @media (max-width: 900px) {
    .mani__grid { grid-template-columns: 1fr; gap: 24px; }
    .mani__h { margin-top: -0.7em; padding: 16px 16px 0 0; max-width: none; }
    .mani__blocks { padding-top: 8px; gap: 24px; }
  }
</style>
