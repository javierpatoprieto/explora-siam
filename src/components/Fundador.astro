---
import { Image } from 'astro:assets';
import Wa from './Wa.astro';
const { site, f } = Astro.props;
---
<section class="fund wrap section" id="dani">
  <div class="fund__img" data-reveal>
    <Image src={f.retrato} alt={site.fundador} class="cover" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 45vw" />
    {f.retratoPie && <span class="cap">{f.retratoPie}</span>}
  </div>
  <div class="fund__txt" data-reveal>
    <span class="eyebrow">{f.etiqueta}</span>
    <h2>{f.titulo}</h2>
    <div class="fund__p">{f.parrafos.map((p: string) => <p>{p}</p>)}</div>
    <div class="fund__cta"><Wa site={site} origen="daniel" icon={false}>{f.boton}</Wa>{f.microcopy && <span class="fund__micro">{f.microcopy}</span>}</div>
  </div>
</section>
<style>
  .fund { display: grid; grid-template-columns: 5fr 6fr; gap: 64px; align-items: center; }
  .fund__img { position: relative; aspect-ratio: 4 / 5; border-radius: var(--r-lg); overflow: hidden; }
  .fund__txt { display: flex; flex-direction: column; gap: 18px; }
  .fund__p { display: flex; flex-direction: column; gap: 12px; color: var(--ink-2); max-width: 56ch; }
  .fund__cta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 8px; }
  .fund__micro { font-size: 13px; color: var(--muted); }
  @media (max-width: 900px) { .fund { grid-template-columns: 1fr; gap: 28px; } }
</style>
